generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Enquiry {
  id          Int      @id @default(autoincrement())

  name        String
  email       String
  phone       String?

  projectType String
  budget      String?
  message     String

  status      String   @default("NEW")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}